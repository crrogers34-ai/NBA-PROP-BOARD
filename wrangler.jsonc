{
  "name": "nba-prop-board",
  "main": "worker.js",
  "compatibility_date": "2026-10-15",
  "keep_vars": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/board.json", "/probable.json", "/lines.json", "/trends.json", "/picks_log.json", "/slates/*"]
  }
}
